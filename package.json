{
  "name": "anonreport",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @anonreport/web dev",
    "dev:worker": "pnpm --filter @anonreport/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "deploy:web": "pnpm --filter @anonreport/web run deploy",
    "deploy:worker": "pnpm --filter @anonreport/worker run deploy"
  }
}
